# =============================================================================
#  JEV AI Quickstart - environment template
#  Copy this file to `.env` and fill in your keys:
#      Windows :  Copy-Item .env.example .env
#      macOS/Linux: cp .env.example .env
#  `.env` is gitignored. Never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Jev (TypeSafe) API key  --- REQUIRED for live mode
#    Create one at: https://console.typesafe.ai/keys
#    Both names are accepted; JEV_AI_API_KEY wins if both are set.
#    TYPESAFE_API_KEY is the canonical name read by the official SDK.
# -----------------------------------------------------------------------------
JEV_AI_API_KEY=your_jev_api_key_here
# TYPESAFE_API_KEY=your_jev_api_key_here

# -----------------------------------------------------------------------------
# 2. OpenAI API key  --- OPTIONAL
#    Only used to *draft* the reply after Jev has made the decision.
#    Leave it blank (or unset) to let the quickstart fall back to a
#    deterministic offline template writer instead.
#    Create one at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# 3. Model selection
#    Jev routes: jev-latest | jev-preview | jev-1.13.0
#    See: https://docs.typesafe.ai/sdk/python/usage#choosing-a-model
# -----------------------------------------------------------------------------
JEV_AI_MODEL=jev-latest
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 4. Confidence gates (0.0 - 1.0)
#    These are *your* risk thresholds, not the model's.
#    Below the floor      -> escalate to a human, no LLM call, no cost.
#    Between floor and max-> draft, but hold the reply for review.
#    At or above max      -> draft and release automatically.
# -----------------------------------------------------------------------------
JEV_AI_CONFIDENCE_FLOOR=0.50
JEV_AI_AUTO_ACT_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# 5. Runtime
#    JEV_AI_OFFLINE=true runs the whole pipeline with canned decisions,
#    no network and no keys - ideal for CI and for a first look.
#    TYPESAFE_BASE_URL is read by the official SDK (leave blank for the
#    default https://api.typesafe.ai).
# -----------------------------------------------------------------------------
JEV_AI_OFFLINE=false
JEV_AI_REQUEST_TIMEOUT_SECONDS=30
JEV_AI_LOG_LEVEL=INFO
# TYPESAFE_BASE_URL=https://api.typesafe.ai
